    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
